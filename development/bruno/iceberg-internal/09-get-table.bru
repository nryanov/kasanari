meta {
  name: 09 Get table
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/iceberg/v1/{{catalogIdIcebergInternal}}/namespaces/{{namespace}}/tables/{{table}}
  body: none
  auth: inherit
}

vars:post-response {
  tableUuid: res.body.metadata['table-uuid']
}

docs {
  Captures tableUuid from metadata for the alter request.
}
