meta {
  name: 07 Alter columns
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/lance/v1/table/{{table}}/alter_columns
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
    {
      "id": [
        "{{table}}"
      ],
      "alterations": [
        {
          "column": "id",
          "rename": "id"
        }
      ]
    }
}
