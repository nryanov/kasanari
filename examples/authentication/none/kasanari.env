# Copy to your environment or pass when starting the server.
# Restart the application after changing auth mode (no rebuild required).

KASANARI_AUTH_TYPE=none

KASANARI_MANAGEMENT_METADATA_JDBC_PROPERTIES__URI=jdbc:postgresql://localhost:5432/postgres
KASANARI_MANAGEMENT_METADATA_JDBC_PROPERTIES__KASANARI_JDBC_USER=postgres
KASANARI_MANAGEMENT_METADATA_JDBC_PROPERTIES__KASANARI_JDBC_PASSWORD=postgres
