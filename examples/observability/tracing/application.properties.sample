####### MANAGEMENT METADATA (PostgreSQL) #######
kasanari.management.metadata.jdbc-properties."uri"=jdbc:postgresql://localhost:5432/postgres
kasanari.management.metadata.jdbc-properties."kasanari.jdbc.user"=postgres
kasanari.management.metadata.jdbc-properties."kasanari.jdbc.password"=postgres

kasanari.authentication.type=none

####### TRACING (OTLP) #######
# Copy into application.properties or export as QUARKUS_* environment variables.

quarkus.otel.traces.enabled=true
quarkus.otel.exporter.otlp.endpoint=http://localhost:4317
quarkus.otel.service.name=kasanari

# Keep metrics on Micrometer/Prometheus (default server settings)
quarkus.otel.metrics.enabled=false
quarkus.otel.logs.enabled=false
